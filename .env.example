# Safe default. Set local explicitly to use the existing Ollama runtime.
LLM_MODE=mock

# Server-only. Only these localhost hostnames on port 11434 are accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Ollama is a separate process; disable cloud features in its own environment.

# Reserved for a future server-side provider. Leave empty in Phase 2.
# LLM_MODE=openai currently returns an error without contacting OpenAI.
OPENAI_API_KEY=

# Supabase project configuration for Phase 3 authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
