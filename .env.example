# Safe default. Set local explicitly to use the existing Ollama runtime.
LLM_MODE=mock

# Server-only. Only these localhost hostnames on port 11434 are accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Ollama is a separate process; disable cloud features in its own environment.

# Local engine for LLM_MODE=local: ollama (separate process, default) or
# embedded (runs inside Next.js; prepare with npm run models:prepare).
LOCAL_RUNTIME=ollama
# Embedded model: qwen3-0.6b (default, fastest) or qwen3-1.7b.
LOCAL_MODEL_ID=qwen3-0.6b
# Optional generation timeout in ms, 30000-300000 (default 120000).
# GENERATION_TIMEOUT_MS=180000

# Disabled provider placeholder; leave empty. A key never activates OpenAI.
# LLM_MODE=openai currently returns an error without contacting OpenAI.
OPENAI_API_KEY=

# Public Supabase project configuration. Never use a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
